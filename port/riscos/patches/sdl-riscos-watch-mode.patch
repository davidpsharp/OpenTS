+/* OpenTS: back to the desktop's mode (as the program quits): if the desktop's mode changed
+   while the program waited on the desktop, that is the mode to keep, not the one from the start. */
+bool RISCOS_SetDisplayModeChecked(SDL_VideoDevice *_this, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    if (mode == &display->desktop_mode) {
+        RISCOS_CheckModeChanged(_this);
+    }
+    return RISCOS_SetDisplayMode(_this, display, mode);
+}
+
 #endif // SDL_VIDEO_DRIVER_RISCOS
