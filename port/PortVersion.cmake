# Writes opents_port.h: the version of the RISC OS (POSIX) port, as the Info window, !Help, the
# log and the main menu report it. This is the port's own number, kept in port/VERSION; it is
# not the engine's (project() in CMakeLists.txt), which the save and network stamps use.
#
# A build is a release only if it is made from a clean tree whose HEAD is the very commit that
# the annotated tag <OPENTS_PORT_TAG_PREFIX><version> (for example riscos-v0.1.0) points at.
# Then the strings say exactly "0.1.0". Every other build says "0.1.0-dev" and names what it
# was built from, so it can never be taken for the release.
#
# Run at configure time, as GitStamp.cmake is. Expects OPENTS_SOURCE_DIR, OPENTS_PORT_VERSION_FILE,
# OPENTS_PORT_TAG_PREFIX and OPENTS_PORT_HEADER; OPENTS_STATUS_IGNORE_SUBMODULES ignores changes
# inside submodules (the RISC OS build patches SDL's working tree from port/riscos/patches).

file(STRINGS "${OPENTS_PORT_VERSION_FILE}" PORT_VERSION LIMIT_COUNT 1)
string(STRIP "${PORT_VERSION}" PORT_VERSION)
if(NOT PORT_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "${OPENTS_PORT_VERSION_FILE} must hold a version such as 0.1.0, not '${PORT_VERSION}'.")
endif()
set(PORT_TAG "${OPENTS_PORT_TAG_PREFIX}${PORT_VERSION}")

set(PORT_RELEASE 0)
set(PORT_DESCRIBE "no git")
set(PORT_DATE "unknown")
set(PORT_MODIFIED 0)
set(PORT_WHY "")
set(PORT_SHORT "unknown")

find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${OPENTS_SOURCE_DIR}/.git")
    macro(port_git var)
        execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN}
            WORKING_DIRECTORY "${OPENTS_SOURCE_DIR}"
            OUTPUT_VARIABLE ${var} OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET RESULT_VARIABLE ${var}_RESULT)
    endmacro()

    port_git(HEAD_COMMIT rev-parse HEAD)
    if(NOT HEAD_COMMIT_RESULT EQUAL 0)
        set(HEAD_COMMIT "")
    endif()

    # The same test for "modified" as GitStamp.cmake's, so the two agree.
    set(SUBMODULES)
    if(OPENTS_STATUS_IGNORE_SUBMODULES)
        set(SUBMODULES --ignore-submodules=dirty)
    endif()
    port_git(STATUS status --porcelain --untracked-files=no ${SUBMODULES})
    if(NOT STATUS_RESULT EQUAL 0 OR NOT STATUS STREQUAL "")
        set(PORT_MODIFIED 1)
    endif()

    port_git(TAG_COMMIT rev-parse -q --verify "refs/tags/${PORT_TAG}^{commit}")
    if(NOT TAG_COMMIT_RESULT EQUAL 0)
        set(TAG_COMMIT "")
    endif()

    port_git(SHORT rev-parse --short HEAD)
    if(SHORT_RESULT EQUAL 0 AND SHORT)
        set(PORT_SHORT "${SHORT}")
    endif()

    port_git(DESCRIBE describe --tags --match "${OPENTS_PORT_TAG_PREFIX}*" --always)
    if(DESCRIBE_RESULT EQUAL 0 AND DESCRIBE)
        set(PORT_DESCRIBE "${DESCRIBE}")
    endif()

    # Day, month name and year, in English whatever the locale (git's own month names).
    port_git(DATE log -1 "--format=%cd" "--date=format:%d %b %Y")
    if(DATE_RESULT EQUAL 0 AND DATE)
        string(REGEX REPLACE "^0" "" PORT_DATE "${DATE}")
    endif()

    if(PORT_MODIFIED)
        set(PORT_WHY "the tree has uncommitted changes")
    elseif(NOT TAG_COMMIT)
        set(PORT_WHY "there is no tag ${PORT_TAG}")
    elseif(NOT TAG_COMMIT STREQUAL HEAD_COMMIT)
        set(PORT_WHY "HEAD is not the commit ${PORT_TAG} points at")
    else()
        set(PORT_RELEASE 1)
    endif()
else()
    set(PORT_WHY "this is not a git checkout")
endif()

set(PORT_MODIFIED_TEXT "")
if(PORT_RELEASE)
    set(PORT_VERSION_SHOWN "${PORT_VERSION}")
    set(PORT_VERSION_LINE "${PORT_VERSION} (${PORT_DATE})")
    set(PORT_VERSION_INFO "${PORT_VERSION_LINE}")
else()
    set(PORT_VERSION_SHOWN "${PORT_VERSION}-dev")
    set(extra "${PORT_DESCRIBE}")
    if(PORT_MODIFIED)
        string(APPEND extra ", modified")
        set(PORT_MODIFIED_TEXT ", modified")
    endif()
    set(PORT_VERSION_LINE "${PORT_VERSION}-dev (${extra}, ${PORT_DATE})")
    # For the Info window, whose field is short.
    set(PORT_VERSION_INFO "${PORT_VERSION}-dev (${PORT_SHORT}${PORT_MODIFIED_TEXT})")
endif()

set(CONTENT
"/* Generated by port/PortVersion.cmake. Edits are overwritten by the next build. */

#pragma once

/* ${PORT_WHY} */
#define OPENTS_PORT_RELEASE       ${PORT_RELEASE}
#define OPENTS_PORT_VERSION       \"${PORT_VERSION_SHOWN}\"
#define OPENTS_PORT_DATE          \"${PORT_DATE}\"
#define OPENTS_PORT_VERSION_LINE  \"${PORT_VERSION_LINE}\"
#define OPENTS_PORT_VERSION_INFO  \"${PORT_VERSION_INFO}\"
#define OPENTS_PORT_TAG           \"${PORT_TAG}\"
")

set(existing "")
if(EXISTS "${OPENTS_PORT_HEADER}")
    file(READ "${OPENTS_PORT_HEADER}" existing)
endif()
if(NOT existing STREQUAL CONTENT)
    file(WRITE "${OPENTS_PORT_HEADER}" "${CONTENT}")
endif()
if(PORT_RELEASE)
    message(STATUS "OpenTS port: release ${PORT_VERSION_LINE}")
else()
    message(STATUS "OpenTS port: ${PORT_VERSION_LINE}; a dev build, as ${PORT_WHY}")
endif()
